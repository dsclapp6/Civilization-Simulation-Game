{
  "_doc": "Barks: short things people say aloud in passing (speech bubbles). At least eight lines per situation have no condition, so any speaker always has something to say; conditional lines add flavour (culture, rank, age, trade, weather). Vars: {addr} (what the speaker calls the listener; 'friend' if none) {daygreet} {part} {weather} {season} {place}. Lines using {first} need a listener, so they carry a tag.",
  "bark": {
    "greet": [
      "Good {daygreet}.",
      "God keep you.",
      "Well met.",
      "God give you good {daygreet}.",
      "Hail, {addr}.",
      "Peace to you.",
      "A fair {daygreet} to you.",
      "Good to see you.",
      "Ho there!",
      "How fare you?",
      { "t": "Blessed holy day to you.", "if": { "tag": "holy" } },
      { "t": "Foul {weather} for it, eh?", "if": { "weather": ["rain", "snow", "cold", "wind"] } },
      { "t": "Lovely {daygreet}!", "if": { "weather": "fair" } },
      { "t": "Hello, hello!", "if": { "age": "child" } },
