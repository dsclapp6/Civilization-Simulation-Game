      { "t": "Wrap up, {first}, it's {weather}.", "if": { "tag": "child", "weather": ["cold", "snow", "rain", "wind"] } },
      { "t": "My love!", "if": { "tag": "spouse", "op": ["warm", "devoted"] } },
