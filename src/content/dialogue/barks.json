      { "t": "Heill.", "if": { "culture": "norse" } },
      { "t": "Gott zum Gruss.", "if": { "culture": "teuton" } },
      { "t": "Mind the {weather}, friend.", "if": { "weather": ["rain", "snow", "fog"] } },
      { "t": "Peace be with you.", "if": { "role": "clergy" } },
      { "t": "Alms, for the love of God?", "if": { "tag": "beggar" } }
    ],
    "greet_superior": [
      "God keep you, {addr}.",
