{
  "_doc": "Economic side of the career table (SPEC §6 'Choosing a field', §13). sim/careers.ts keeps the identity of each career; this file adds what the economy needs. careers.<id>: skill = main skill trained by the work; workplace = building kinds the work happens at (workSpot, employment); anim/held = work animation and tool shown; wage = pence per day when employed by someone else, by ladder stage (apprentices: board and lodging only); income = pence per working day the head of a household of that career earns at each stage in the macro economy; produces/consumes = macro goods per working day (stage >= 1); premium/term = apprenticeship fee (pence) and length (years); minAge; sells/buys = goods a trader of this career will deal in. fields: the SPEC §6 table as shown to the player (entry, ladder, historical sex rule). tests: recruiter's tests (SPEC §13).",
  "fields": {
    "land": { "label": "Land", "entry": "Work your family's strips or hire on as a farmhand, then rent strips of your own from the reeve", "ladder": ["Farmhand", "Tenant (strips)", "Free tenant", "Yeoman", "Gentry (buy a manor)"], "sexRule": "Open to both; women hold land as widows and coheiresses." },
    "husbandry": { "label": "Husbandry", "entry": "Herd for the village, or keep your own beasts on the common pasture", "ladder": ["Herd boy or girl", "Shepherd", "Own flock", "Wool trader"], "sexRule": "Open to both." },
    "brewing": { "label": "Brewing", "entry": "Brew at home and sell the surplus ale", "ladder": ["Brewer", "Alewife", "Alehouse keeper", "Tavern keeper"], "sexRule": "Open to both; women dominate the trade." },
    "craft": { "label": "Craft", "entry": "A master must accept you: kin, a good name, or a premium", "ladder": ["Apprentice (about 7 years)", "Journeyman", "Master (after a masterpiece)", "Guild warden"], "sexRule": "Men in most trades; women in spinning and weaving, and widows may run the workshop." },
    "trade": { "label": "Trade", "entry": "Shop boy or peddler; you need capital to start", "ladder": ["Peddler", "Merchant", "Great merchant", "Alderman", "Mayor"], "sexRule": "Men; women trade as femmes soles in towns." },
    "arms": { "label": "Arms", "entry": "Pass the recruiter's test; the lord may call every man of 15 to 60 to the levy", "ladder": ["Levy", "Archer or man-at-arms", "Sergeant", "Captain", "Knighted for valour"], "sexRule": "In this land only men were mustered: the levy, the lord's companies and the recruiters' tests took men alone." },
    "knighthood": { "label": "Knighthood", "entry": "Knight-born pages become squires at 14; commoners are knighted only for valour", "ladder": ["Page", "Squire", "Knight"], "sexRule": "Knighthood was for men only; a noblewoman might hold land and titles, but not the sword." },
    "church": { "label": "Church", "entry": "A novice needs letters or a gift to the house", "ladder": ["Novice", "Monk or priest", "Prior", "Abbot or bishop"], "sexRule": "Men: monk or priest. Women: nun, prioress, abbess." },
    "service": { "label": "Service", "entry": "Take service in a great household", "ladder": ["Servant", "Clerk (needs Letters)", "Bailiff", "Steward", "Royal official"], "sexRule": "Both as servants; men for the offices." },
    "healing": { "label": "Healing", "entry": "Learn from a healer or in the infirmary", "ladder": ["Herbalist", "Healer", "Physician (needs Letters)"], "sexRule": "Both; midwives are women." },
    "outlaw": { "label": "Outlaw", "entry": "Poach, rob, flee", "ladder": ["Poacher", "Outlaw", "Band leader", "Pardon or rebellion"], "sexRule": "Both." },
    "freedom": { "label": "Serf's escape", "entry": "Buy your freedom from the lord, or live a year and a day unclaimed in a chartered town", "ladder": ["Unfree", "Free"], "sexRule": "Both." }
  },
