{
  "name": "millennia",
  "private": true,
  "version": "0.2.0",
  "description": "Millennia \u2014 live one life at a time inside a fully simulated medieval world. Browser build (TypeScript + Three.js).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/headless.ts",
    "test:perf": "PERF=1 vitest run --no-file-parallelism perf.test"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
